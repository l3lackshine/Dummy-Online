.pl-left,.pl-right{padding:0}
.pl-bottom{grid-column:1/-1;grid-row:3;justify-self:end;display:flex;align-items:flex-end;gap:8px;margin:0 12px 0 0;padding:0}
.pl-bottom .chr{height:calc(var(--chr)*.74);overflow:hidden}.pl-bottom .chr .avatar-img{height:calc(var(--chr)*1.08);object-position:center top}
.pl-bottom .pl-info{margin-bottom:6px}
