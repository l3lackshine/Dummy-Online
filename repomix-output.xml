/* ===== v8: ตัวละครขนาดเท่ากัน / พื้นหลังรายผู้เล่น / แผงไพ่ (dock) ที่ใส่สกินได้ ===== */
:root{--chr:92px;--btn-img:none;--dock-bg:linear-gradient(#0000,#0004);--dock-border:#ffffff30;
 --b-blue-1:#4aa3ff;--b-blue-2:#1f6fe0;--b-blue-3:#134aa0;--b-org-1:#ffa13a;--b-org-2:#f0640d;--b-org-3:#a9440a;
 --b-grn-1:#4cd36f;--b-grn-2:#1f9c4a;--b-grn-3:#14703a;--b-g-1:#4a5886;--b-g-2:#323d66;--b-g-3:#1b2240;--b-tool-1:#0006;--b-tool-2:#0006;--b-tool-3:#0000}
@media (max-width:360px){:root{--chr:80px}}
@media (orientation:landscape) and (max-height:600px){:root{--chr:54px}}
.chars{display:flex;gap:10px;justify-content:center;margin:4px 0 8px}
.char-opt{flex:1;max-width:150px;background:#0c1536;border:2px solid var(--line);border-radius:14px;padding:6px 4px;color:#fff;font:700 12px Sarabun,sans-serif;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:4px}
.char-opt img{height:84px;width:auto;max-width:100%;object-fit:contain}
.char-opt.on{border-color:var(--gold);box-shadow:0 0 0 3px #f2b84b66;background:#1d2a5e}
.box .char-opt{margin:0;width:auto;padding:6px 4px;font-size:12px;background:#0c1536;box-shadow:none}.box .char-opt.on{background:#1d2a5e;box-shadow:0 0 0 3px #f2b84b66}
.swatches{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin:2px 0 6px}
.box .sw{width:42px;height:42px;margin:0;padding:0;border-radius:12px;border:2px solid #fff5;font-size:16px;color:#fff;text-shadow:0 1px 2px #000a;box-shadow:none}
.box .dk{width:auto;flex:1;min-width:84px;margin:0;padding:10px 6px;border-radius:12px;border:2px solid #fff5;font-size:13px;color:#fff;text-shadow:0 1px 2px #000a;box-shadow:none}
.box .sw.on,.box .dk.on{border-color:var(--gold);box-shadow:0 0 0 3px #f2b84b88}
/* ตัวละคร: ขนาดเท่ากันทุกตัว (กรอบ --chr) ภาพชิดล่าง */
.chr{display:block;flex:none;line-height:0}
.arena .pl .chr,.dock-me .chr{width:var(--chr);height:calc(var(--chr)*1.08)}
.chr .avatar-img{display:block;width:100%;height:100%;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 3px 3px #0009)}
/* ที่นั่งของคู่แข่ง: พื้นหลังของผู้เล่นคนนั้น + โต๊ะ (z-index สูงกว่า) ทับตัวละครส่วนหนึ่ง */
.felt{position:relative;z-index:3}
.arena .pl{position:relative;z-index:1;border-radius:18px;padding:4px 8px;border:2px solid #ffffff40;box-shadow:0 3px 0 #0005;color:var(--ink,#fff)}
.pl-info small{color:inherit;opacity:.85}.pl-info b{max-width:none}
.pl-top{grid-column:2;grid-row:1;justify-self:center;align-items:flex-start;margin-bottom:calc(var(--chr)*-.40)}
.pl-top .pl-info{margin-top:6px}
.pl-left,.pl-right{flex-direction:column;align-self:center;width:auto;padding:4px 2px}
.pl-left{grid-column:1;grid-row:2}.pl-right{grid-column:3;grid-row:2}
.pl-left{margin-right:calc(var(--chr)*-.42)}.pl-right{margin-left:calc(var(--chr)*-.42)}.pl-left .chr{align-self:flex-start}.pl-right .chr{align-self:flex-end}
.pl-left .pl-info,.pl-right .pl-info{width:max-content;min-width:46px;align-items:center}
.pl-left .pl-info{align-self:flex-start}.pl-right .pl-info{align-self:flex-end}
.arena{grid-template-rows:auto minmax(0,1fr)}
.pl.active,.dock-me.active{box-shadow:0 0 0 3px var(--gold),0 0 14px #f2b84bcc}
.pl.active .chr .avatar-img,.dock-me.active .chr .avatar-img{animation:bob 1s ease-in-out infinite}
@media (prefers-reduced-motion:reduce){.pl.active .chr .avatar-img,.dock-me.active .chr .avatar-img{animation:none}}
/* แผงไพ่ของเรา (dock) = UI แยกที่ใส่สกินได้: ตัวละครเรา + มือ + ปุ่มเรียงไพ่ + ปุ่มคำสั่ง */
.dock-wrap{position:relative}
.dock-me{position:relative;z-index:1;display:flex;align-items:flex-end;justify-content:flex-end;gap:8px;width:fit-content;margin:0 12px 0 auto;padding:4px 10px 0;border-radius:18px 18px 0 0;border:2px solid #ffffff40;border-bottom:0;color:var(--ink,#fff)}
.dock-me .chr{height:calc(var(--chr)*.74);overflow:hidden}.dock-me .chr .avatar-img{height:calc(var(--chr)*1.08);object-position:center top}
.dock-me .pl-info{padding-bottom:6px}
.dock{position:relative;z-index:2;background:var(--dock-bg);border:2px solid var(--dock-border);border-radius:20px 20px 0 0;padding:4px 0 0}
.dock .tools button{background:linear-gradient(var(--b-tool-1),var(--b-tool-2));box-shadow:0 2px 0 var(--b-tool-3)}
.dock .acts button{background:var(--btn-img) center/100% 100% no-repeat,linear-gradient(var(--b-g-1),var(--b-g-2));box-shadow:0 4px 0 var(--b-g-3)}
.dock .acts button.blue{background:var(--btn-img) center/100% 100% no-repeat,linear-gradient(var(--b-blue-1),var(--b-blue-2));box-shadow:0 4px 0 var(--b-blue-3)}
.dock .acts button.org{background:var(--btn-img) center/100% 100% no-repeat,linear-gradient(var(--b-org-1),var(--b-org-2));box-shadow:0 4px 0 var(--b-org-3)}
.dock .acts button.grn{background:var(--btn-img) center/100% 100% no-repeat,linear-gradient(var(--b-grn-1),var(--b-grn-2));box-shadow:0 4px 0 var(--b-grn-3)}
@media (orientation:landscape) and (max-height:600px){.arena .pl{padding:2px 4px}.pl-top{margin-bottom:calc(var(--chr)*-.34)}.pl-left,.pl-right{padding:2px}.pl-left{margin-right:calc(var(--chr)*-.3)}.pl-right{margin-left:calc(var(--chr)*-.3)}.pl-left .pl-info,.pl-right .pl-info{min-width:0;font-size:9px}.dock-me{margin-right:6px}.dock-me .chr{height:calc(var(--chr)*.7)}.dock-me .chr .avatar-img{height:calc(var(--chr)*1.08)}}

/* ===== v9: พื้นหลังที่นั่งเป็นกรอบรูปล้อมโต๊ะ (ตัดทแยงที่มุมโต๊ะ) ===== */
.top{order:0}.logs,.hint{order:1}.arena{order:2}.dock-wrap{order:3}
.arena{position:relative;padding:0;gap:4px;grid-template-rows:auto minmax(0,1fr) auto;--L:0px;--R:0px;--T:0px;--B:0px}
.frame{position:absolute;inset:0;z-index:0;pointer-events:none}
.fb{position:absolute;inset:0;display:block;background-size:cover;background-position:center;transition:filter .25s}
.fb-top{clip-path:polygon(0 0,100% 0,calc(100% - var(--R)) var(--T),var(--L) var(--T))}
.fb-right{clip-path:polygon(100% 0,100% 100%,calc(100% - var(--R)) calc(100% - var(--B)),calc(100% - var(--R)) var(--T))}
.fb-bottom{clip-path:polygon(0 100%,100% 100%,calc(100% - var(--R)) calc(100% - var(--B)),var(--L) calc(100% - var(--B)))}
.fb-left{clip-path:polygon(0 0,var(--L) var(--T),var(--L) calc(100% - var(--B)),0 100%)}
.frame.has-active .fb{filter:brightness(.78)}.frame.has-active .fb.active{filter:brightness(1.12) saturate(1.15)}
.arena .pl{background:none;border:0;box-shadow:none;padding:0}
.pl.active{box-shadow:none}
